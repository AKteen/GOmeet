# Backend only. Copy to backend/.env for local runs.
# On Render, set these in the API service. Do not commit backend/.env.

# Local only. On Render, use the Postgres Internal Database URL and the Key Value
# internal connection string. Do not paste this localhost URL into Render.
DATABASE_URL=postgresql://gomeet:gomeet@localhost:5432/gomeet
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080
# Comma-separated. On Render: the Vercel origin, https, no trailing slash.
# Example: https://gomeet.vercel.app
CORS_ORIGINS=http://localhost:3000

AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Quote the app key because # starts a comment.
AGORA_CHAT_APP_KEY=
AGORA_CHAT_REST_HOST=

# Agora Console REST key, used for Real-Time Speech-to-Text. Not the app certificate.
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
